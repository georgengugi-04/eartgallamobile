# Base URL of the E-ArtGalla API, including /api, no trailing slash.
# Physical device (Expo Go): your computer's LAN IP, NOT localhost.
#   e.g. http://192.168.1.20:5000/api
# Android emulator: http://10.0.2.2:5000/api
# Production: https://your-api-domain/api
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000/api
